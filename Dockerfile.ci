FROM node:22-bookworm-slim AS node

FROM ghcr.io/rentany/php-base:php8.5

LABEL org.opencontainers.image.source="https://github.com/rentany/php-base" \
      org.opencontainers.image.description="PHP 8.5 CI tools for rentany: SQLite, Imagick, Node 22, Composer, GitHub CLI and ShellCheck"

# Upgrade the frozen runtime libraries before adding packages from rolling Wolfi.
RUN apk upgrade --no-cache && apk add --no-cache \
    php-8.5-pdo_sqlite php-8.5-imagick gh jq

# Pest loads the entire suite before starting workers; PHP's 128M default is too small.
RUN printf 'memory_limit=512M\n' > /etc/php/conf.d/99-ci.ini

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN set -eux; \
    curl -fsSL --retry 3 --max-time 120 \
      https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.gz \
      -o /tmp/shellcheck.tar.gz; \
    echo 'b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6  /tmp/shellcheck.tar.gz' | sha256sum -c -; \
    tar -xzf /tmp/shellcheck.tar.gz -C /tmp; \
    cp /tmp/shellcheck-v0.11.0/shellcheck /usr/local/bin/shellcheck; \
    rm -rf /tmp/shellcheck*; \
    php -r 'foreach (["pdo_sqlite", "sqlite3", "imagick", "gd", "redis", "intl", "mbstring", "bcmath", "pcntl", "zip", "sockets", "exif"] as $ext) { if (!extension_loaded($ext)) { throw new RuntimeException("Missing extension: $ext"); } } if (extension_loaded("xdebug")) { throw new RuntimeException("Xdebug must be disabled in CI"); }'; \
    composer --version; \
    node --version; \
    npm --version; \
    gh --version; \
    shellcheck --version

ENV COMPOSER_ALLOW_SUPERUSER=1
WORKDIR /workspace
